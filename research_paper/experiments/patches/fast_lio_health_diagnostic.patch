+void write_health_diagnostic(const char *unavailable_reason)
+{
+    if (!health_export_en) return;
+    const uint64_t stamp_ns = ros::Time().fromSec(lidar_end_time).toNSec();
+    for (double scale_m : {1.0, 3.0, 5.0})
+    {
+        health_stream << stamp_ns << ',' << scale_m << ',' << health_accepted_count;
+        if (!health_valid || health_accepted_count < 6)
+        {
+            health_stream << ",,,,,,,false,"
+                          << (health_valid ? "INSUFFICIENT_CORRESPONDENCES" : unavailable_reason)
+                          << ",last_scan_to_map_linearization\n";
+            continue;
+        }
+        Eigen::Matrix<double, 6, 6> scale = Eigen::Matrix<double, 6, 6>::Identity();
+        scale.bottomRightCorner<3, 3>() /= scale_m;
+        const Eigen::Matrix<double, 6, 6> info = scale * health_gram * scale /
+            (static_cast<double>(health_accepted_count) * LASER_POINT_COV);
+        Eigen::SelfAdjointEigenSolver<Eigen::Matrix<double, 6, 6>> solver(info);
+        if (solver.info() != Eigen::Success || !solver.eigenvalues().allFinite())
+        {
+            health_stream << ",,,,,,,false,NONFINITE_INFORMATION,last_scan_to_map_linearization\n";
+            continue;
+        }
+        for (int i = 0; i < 6; ++i) health_stream << ',' << std::max(0.0, solver.eigenvalues()(i));
+        health_stream << ",true,,last_scan_to_map_linearization\n";
+    }
+    health_stream.flush();
+}
