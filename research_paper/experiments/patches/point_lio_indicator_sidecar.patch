diff --git a/src/IndicatorSidecar.cpp b/src/IndicatorSidecar.cpp
new file mode 100644
index 0000000..7fdc5de
--- /dev/null
+++ b/src/IndicatorSidecar.cpp
@@ -0,0 +1,419 @@
+#include "IndicatorSidecar.h"
+
+#include <cmath>
+#include <iomanip>
+
+PointLioIndicatorSidecar pointlio_indicator_sidecar;
+
+PointLioIndicatorSidecar::PointLioIndicatorSidecar()
+    : enabled_(false), initialized_(false), next_frame_id_(1), segment_id_(0),
+      reset_event_order_(0), active_frame_id_(0), frame_active_(false),
+      group_active_(false), io_failed_(false)
+{
+}
+
+bool PointLioIndicatorSidecar::initialize(const std::string &output_dir,
+                                          std::string &error)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (initialized_)
+    {
+        error = "indicator sidecar was initialized more than once";
+        return false;
+    }
+    initialized_ = true;
+    io_failed_ = false;
+    if (output_dir.empty())
+    {
+        enabled_ = false;
+        return true;
+    }
+
+    const std::string prefix = output_dir + "/";
+    frames_stream_.open(prefix + "frame_ledger.csv", std::ios::out | std::ios::trunc);
+    groups_stream_.open(prefix + "measurement_groups.csv", std::ios::out | std::ios::trunc);
+    jacobians_stream_.open(prefix + "jacobian_rows.csv", std::ios::out | std::ios::trunc);
+    resets_stream_.open(prefix + "reset_events.csv", std::ios::out | std::ios::trunc);
+    if (!frames_stream_ || !groups_stream_ || !jacobians_stream_ || !resets_stream_)
+    {
+        error = "could not open all Point-LIO sidecar outputs under " + output_dir;
+        frames_stream_.close();
+        groups_stream_.close();
+        jacobians_stream_.close();
+        resets_stream_.close();
+        return false;
+    }
+
+    frames_stream_ << "frame_id,input_header_stamp_ns,timestamp_ns,timestamp_source,"
+                      "segment_id,source_stage,frame_state,run_state,"
+                      "unavailable_reason,expected_group_count,"
+                      "processed_group_count,empty_group_count,accepted_count\n";
+    groups_stream_ << "frame_id,group_index,group_timestamp_ns,callback_count,"
+                      "accepted_count,rotation_snapshot_present";
+    jacobians_stream_ << "frame_id,group_index,group_timestamp_ns,row_index";
+    for (int row = 0; row < 3; ++row)
+        for (int col = 0; col < 3; ++col)
+        {
+            groups_stream_ << ",R" << row << col;
+            jacobians_stream_ << ",R" << row << col;
+        }
+    for (int col = 0; col < 6; ++col)
+        jacobians_stream_ << ",J_body" << col;
+    for (int col = 0; col < 6; ++col)
+        jacobians_stream_ << ",J_common" << col;
+    groups_stream_ << '\n';
+    jacobians_stream_ << '\n';
+    resets_stream_ << "event_order,affected_frame_id,sensor_timestamp_ns,"
+                      "reset_reason,old_segment_id,new_segment_id\n";
+    frames_stream_ << std::setprecision(17);
+    groups_stream_ << std::setprecision(17);
+    jacobians_stream_ << std::setprecision(17);
+    resets_stream_ << std::setprecision(17);
+    enabled_ = true;
+    if (!frames_stream_ || !groups_stream_ || !jacobians_stream_ || !resets_stream_)
+    {
+        io_failed_ = true;
+        error = "could not write Point-LIO sidecar headers under " + output_dir;
+        return false;
+    }
+    return true;
+}
+
+bool PointLioIndicatorSidecar::is_enabled() const
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    return enabled_;
+}
+
+bool PointLioIndicatorSidecar::persistence_ok() const
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    return !io_failed_;
+}
+
+std::uint32_t PointLioIndicatorSidecar::register_input_frame(
+    std::uint64_t header_stamp_ns)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    const std::uint32_t frame_id = next_frame_id_++;
+    FrameState frame;
+    frame.frame_id = frame_id;
+    frame.header_stamp_ns = header_stamp_ns;
+    frame.timestamp_ns = header_stamp_ns + 100000000ULL;
+    frame.segment_id = segment_id_;
+    frame.source_stage = "RAW_INPUT";
+    frames_[frame_id] = frame;
+    return frame_id;
+}
+
+void PointLioIndicatorSidecar::mark_unavailable(
+    std::uint32_t frame_id, std::uint64_t timestamp_ns,
+    const std::string &timestamp_source, const std::string &source_stage,
+    const std::string &reason, const std::string &run_state)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::map<std::uint32_t, FrameState>::iterator it = frames_.find(frame_id);
+    if (it == frames_.end()) return;
+    FrameState &frame = it->second;
+    if (frame.finalized) return;
+    frame.timestamp_ns = timestamp_ns;
+    frame.timestamp_source = timestamp_source;
+    frame.source_stage = source_stage;
+    frame.state = (run_state == "COMPLETE") ? "UNAVAILABLE" : "RUN_INCOMPLETE";
+    frame.unavailable_reason = reason;
+    frame.run_state = run_state;
+    frame.expected_group_count = 0;
+    frame.processed_group_count = 0;
+    frame.empty_group_count = 0;
+    frame.accepted_count = 0;
+    frame.finalized = true;
+}
+
+void PointLioIndicatorSidecar::begin_frame(std::uint32_t frame_id,
+                                           std::uint64_t lidar_end_ns)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::map<std::uint32_t, FrameState>::iterator it = frames_.find(frame_id);
+    if (it == frames_.end() || it->second.finalized) return;
+    active_frame_id_ = frame_id;
+    frame_active_ = true;
+    group_active_ = false;
+    FrameState &frame = it->second;
+    frame.timestamp_ns = lidar_end_ns;
+    frame.timestamp_source = "ACTUAL";
+    frame.source_stage = "PROCESSING";
+    frame.segment_id = segment_id_;
+}
+
+void PointLioIndicatorSidecar::set_frame_stage(
+    const std::string &source_stage, const std::string &unavailable_reason)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!frame_active_) return;
+    FrameState &frame = frames_[active_frame_id_];
+    frame.source_stage = source_stage;
+    frame.unavailable_reason = unavailable_reason;
+}
+
+void PointLioIndicatorSidecar::set_expected_groups(
+    std::size_t expected_group_count)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!frame_active_) return;
+    FrameState &frame = frames_[active_frame_id_];
+    frame.expected_group_count = expected_group_count;
+}
+
+void PointLioIndicatorSidecar::begin_group(
+    std::size_t group_index, std::uint64_t group_timestamp_ns)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!frame_active_ || group_active_) return;
+    active_group_ = GroupState();
+    active_group_.group_index = group_index;
+    active_group_.timestamp_ns = group_timestamp_ns;
+    group_active_ = true;
+}
+
+void PointLioIndicatorSidecar::capture_group(
+    const Eigen::Matrix3d &rotation_world_body_preupdate,
+    const Eigen::MatrixXd &measurement_jacobian)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!group_active_) return;
+    GroupState &group = active_group_;
+    group.callback_count += 1;
+    if (measurement_jacobian.cols() < 6)
+    {
+        return;
+    }
+
+    group.rotation = rotation_world_body_preupdate;
+    group.has_rotation = true;
+    for (Eigen::Index i = 0; i < measurement_jacobian.rows(); ++i)
+    {
+        Eigen::Matrix<double, 1, 6> body_row;
+        for (int col = 0; col < 6; ++col)
+            body_row(col) = measurement_jacobian(i, col);
+        Eigen::Matrix<double, 1, 6> common_row = body_row;
+        common_row.segment<3>(3) = body_row.segment<3>(3)
+            * rotation_world_body_preupdate.transpose();
+        group.body_rows.push_back(body_row);
+        group.common_rows.push_back(common_row);
+        group.accepted_count += 1;
+    }
+}
+
+bool PointLioIndicatorSidecar::finish_group()
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!frame_active_ || !group_active_) return false;
+    FrameState &frame = frames_[active_frame_id_];
+    write_group(active_group_);
+    const bool completed = active_group_.callback_count == 1
+        && active_group_.has_rotation;
+    if (completed)
+    {
+        frame.processed_group_count += 1;
+        if (active_group_.accepted_count == 0)
+            frame.empty_group_count += 1;
+        frame.accepted_count += active_group_.accepted_count;
+    }
+    else
+    {
+        frame.run_state = "RUN_INCOMPLETE";
+        frame.unavailable_reason = "MEASUREMENT_CALLBACK_COUNT_MISMATCH";
+    }
+    active_group_ = GroupState();
+    group_active_ = false;
+    return completed;
+}
+
+void PointLioIndicatorSidecar::finish_frame()
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!frame_active_) return;
+    FrameState &frame = frames_[active_frame_id_];
+    if (frame.finalized)
+    {
+        frame_active_ = false;
+        group_active_ = false;
+        return;
+    }
+
+    if (frame.expected_group_count != frame.processed_group_count)
+    {
+        frame.state = "RUN_INCOMPLETE";
+        frame.run_state = "RUN_INCOMPLETE";
+        frame.unavailable_reason = "INCOMPLETE_GROUP_PROCESSING";
+    }
+    else if (frame.run_state != "COMPLETE")
+    {
+        frame.state = "RUN_INCOMPLETE";
+    }
+    else if (!frame.unavailable_reason.empty())
+    {
+        frame.state = "UNAVAILABLE";
+    }
+    else if (frame.source_stage != "MEASUREMENT")
+    {
+        frame.state = "UNAVAILABLE";
+        frame.unavailable_reason = "FRAME_STAGE_UNAVAILABLE";
+    }
+    else if (frame.accepted_count < 6)
+    {
+        frame.state = "UNAVAILABLE";
+        frame.unavailable_reason = "INSUFFICIENT_CORRESPONDENCES";
+    }
+    else
+    {
+        frame.state = "READY";
+    }
+    frame.finalized = true;
+    write_frame(frame);
+    frame_active_ = false;
+    group_active_ = false;
+}
+
+void PointLioIndicatorSidecar::record_reset(
+    std::uint32_t affected_frame_id, std::uint64_t sensor_timestamp_ns,
+    const std::string &reason)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    const std::uint32_t old_segment = segment_id_;
+    const std::uint32_t new_segment = old_segment + 1;
+    ++reset_event_order_;
+    if (enabled_)
+    {
+        resets_stream_ << reset_event_order_ << ',' << affected_frame_id << ','
+                       << sensor_timestamp_ns << ',' << reason << ','
+                       << old_segment << ',' << new_segment << '\n';
+        resets_stream_.flush();
+        if (!resets_stream_) io_failed_ = true;
+    }
+    segment_after_reset_[affected_frame_id] = new_segment;
+    std::map<std::uint32_t, FrameState>::iterator it = frames_.find(affected_frame_id);
+    if (it != frames_.end() && !it->second.finalized)
+    {
+        FrameState &frame = it->second;
+        frame.segment_id = old_segment;
+        frame.timestamp_source = "ACTUAL";
+        if (frame.timestamp_ns == 0)
+            frame.timestamp_ns = sensor_timestamp_ns;
+        frame.source_stage = "RESET";
+        frame.state = "UNAVAILABLE";
+        frame.unavailable_reason = "RESET_IN_FRAME";
+        frame.finalized = true;
+        write_frame(frame);
+    }
+    segment_id_ = new_segment;
+    if (frame_active_ && active_frame_id_ == affected_frame_id)
+    {
+        frame_active_ = false;
+        group_active_ = false;
+    }
+}
+
+std::uint32_t PointLioIndicatorSidecar::current_segment_id() const
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    return segment_id_;
+}
+
+bool PointLioIndicatorSidecar::flush_pending()
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (std::map<std::uint32_t, FrameState>::iterator it = frames_.begin();
+         it != frames_.end(); ++it)
+    {
+        FrameState &frame = it->second;
+        if (!frame.finalized)
+        {
+            frame.state = "RUN_INCOMPLETE";
+            frame.run_state = "RUN_INCOMPLETE";
+            frame.unavailable_reason = "MISSING_FRAME_PROCESSING";
+            frame.source_stage = "SHUTDOWN_PENDING";
+            frame.finalized = true;
+        }
+        if (!frame.written)
+        {
+            frame.segment_id = 0;
+            for (std::map<std::uint32_t, std::uint32_t>::const_iterator reset =
+                     segment_after_reset_.begin();
+                 reset != segment_after_reset_.end(); ++reset)
+            {
+                if (reset->first < frame.frame_id)
+                    frame.segment_id = reset->second;
+            }
+            write_frame(frame);
+        }
+    }
+    if (enabled_)
+    {
+        frames_stream_.flush();
+        groups_stream_.flush();
+        jacobians_stream_.flush();
+        resets_stream_.flush();
+        if (!frames_stream_ || !groups_stream_ || !jacobians_stream_ || !resets_stream_)
+            io_failed_ = true;
+    }
+    frame_active_ = false;
+    group_active_ = false;
+    return !io_failed_;
+}
+
+void PointLioIndicatorSidecar::write_frame(FrameState &frame)
+{
+    if (!enabled_)
+    {
+        frame.written = true;
+        return;
+    }
+    frames_stream_ << frame.frame_id << ',' << frame.header_stamp_ns << ','
+                   << frame.timestamp_ns << ',' << frame.timestamp_source << ','
+                   << frame.segment_id << ',' << frame.source_stage << ','
+                   << frame.state << ',' << frame.run_state << ','
+                   << frame.unavailable_reason << ','
+                   << frame.expected_group_count << ','
+                   << frame.processed_group_count << ','
+                   << frame.empty_group_count << ',' << frame.accepted_count
+                   << '\n';
+    if (frames_stream_)
+        frame.written = true;
+    else
+        io_failed_ = true;
+}
+
+void PointLioIndicatorSidecar::write_group(const GroupState &group)
+{
+    if (!enabled_) return;
+    groups_stream_ << active_frame_id_ << ',' << group.group_index << ','
+                   << group.timestamp_ns << ',' << group.callback_count << ','
+                   << group.accepted_count << ','
+                   << (group.has_rotation ? "true" : "false");
+    for (int row = 0; row < 3; ++row)
+        for (int col = 0; col < 3; ++col)
+            groups_stream_ << ',' << group.rotation(row, col);
+    groups_stream_ << '\n';
+
+    for (std::size_t i = 0; i < group.common_rows.size(); ++i)
+    {
+        jacobians_stream_ << active_frame_id_ << ',' << group.group_index << ','
+                          << group.timestamp_ns << ',' << i;
+        for (int row = 0; row < 3; ++row)
+            for (int col = 0; col < 3; ++col)
+                jacobians_stream_ << ',' << group.rotation(row, col);
+        for (int col = 0; col < 6; ++col)
+            jacobians_stream_ << ',' << group.body_rows[i](col);
+        for (int col = 0; col < 6; ++col)
+            jacobians_stream_ << ',' << group.common_rows[i](col);
+        jacobians_stream_ << '\n';
+    }
+    if (!groups_stream_ || !jacobians_stream_) io_failed_ = true;
+}
+
+std::uint64_t PointLioIndicatorSidecar::seconds_to_ns(double seconds)
+{
+    if (!std::isfinite(seconds) || seconds < 0.0) return 0;
+    return static_cast<std::uint64_t>(std::llround(seconds * 1e9));
+}
diff --git a/src/IndicatorSidecar.h b/src/IndicatorSidecar.h
new file mode 100644
index 0000000..7bdbf0f
--- /dev/null
+++ b/src/IndicatorSidecar.h
@@ -0,0 +1,100 @@
+#ifndef POINTLIO_INDICATOR_SIDECAR_H
+#define POINTLIO_INDICATOR_SIDECAR_H
+
+#include <Eigen/Dense>
+
+#include <cstdint>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+class PointLioIndicatorSidecar
+{
+public:
+    PointLioIndicatorSidecar();
+
+    // Empty output_dir disables file output but still assigns stable frame IDs.
+    bool initialize(const std::string &output_dir, std::string &error);
+    bool is_enabled() const;
+    std::uint32_t register_input_frame(std::uint64_t header_stamp_ns);
+    void mark_unavailable(std::uint32_t frame_id, std::uint64_t timestamp_ns,
+                          const std::string &timestamp_source,
+                          const std::string &source_stage,
+                          const std::string &reason,
+                          const std::string &run_state = "COMPLETE");
+    void begin_frame(std::uint32_t frame_id, std::uint64_t lidar_end_ns);
+    void set_frame_stage(const std::string &source_stage,
+                         const std::string &unavailable_reason = "");
+    void set_expected_groups(std::size_t expected_group_count);
+    void begin_group(std::size_t group_index, std::uint64_t group_timestamp_ns);
+    void capture_group(const Eigen::Matrix3d &rotation_world_body_preupdate,
+                       const Eigen::MatrixXd &measurement_jacobian);
+    bool finish_group();
+    void finish_frame();
+    void record_reset(std::uint32_t affected_frame_id,
+                      std::uint64_t sensor_timestamp_ns,
+                      const std::string &reason);
+    std::uint32_t current_segment_id() const;
+    bool flush_pending();
+    bool persistence_ok() const;
+
+private:
+    struct FrameState
+    {
+        std::uint32_t frame_id = 0;
